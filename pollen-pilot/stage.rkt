#lang racket/base
(require racket/file racket/path racket/list racket/string racket/runtime-path json)
(define-runtime-path pilot ".")
(define chapters (build-path pilot 'up "chapters"))
(define output (build-path pilot "ch"))
(make-directory* output)
(define files
  (sort (filter (lambda (p) (regexp-match? #rx"[.]md$" (path->string p)))
                (directory-list chapters))
        string<? #:key path->string))
(define entries
  (for/list ([p (in-list files)])
    (define name (path->string p))
    (define slug (substring name 0 (- (string-length name) 3)))
    (define source (file->string (build-path chapters p)))
    (define heading (regexp-match #px"(?m:^# +([^\r\n]+))" source))
    (unless heading (error 'stage "Missing title in ~a" name))
    (define escaped (string-replace source "◊" "◊|\"◊\"|"))
    (display-to-file (string-append "#lang pollen\n" escaped)
                     (build-path output (string-append slug ".html.pmd"))
                     #:exists 'truncate/replace)
    (hasheq 'slug slug 'title (string-trim (cadr heading))
            'url (string-append "ch/" slug ".html") 'text source)))
(call-with-output-file (build-path pilot "chapters.js")
  (lambda (out)
    (display "window.BOOK_CHAPTERS = " out)
    (write-json entries out)
    (display ";\n" out))
  #:exists 'truncate/replace)
(printf "Staged ~a chapters and generated index\n" (length files))
